# =========================================================================
# SABER Environment Configuration Template
# =========================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.template .env
#
# Then edit .env with your credentials (never commit .env to git!)
# =========================================================================

# -------------------------------------------------------------------------
# Azure OpenAI Configuration (REQUIRED)
# -------------------------------------------------------------------------
# Get these values from your Azure OpenAI resource in the Azure portal

# Your Azure OpenAI API key
AZUREAI_OPENAI_API_KEY=

# Your Azure OpenAI endpoint URL (should end with .openai.azure.com)
AZUREAI_OPENAI_BASE_URL=

# API version (use 2024-12-01-preview or later for latest features)
AZUREAI_OPENAI_API_VERSION=2024-12-01-preview

# -------------------------------------------------------------------------
# Development Settings (Optional)
# -------------------------------------------------------------------------
# Uncomment for development/debugging

# DEBUG=false
# SABER_DEV_MODE=false

# =========================================================================
# Important Notes:
# =========================================================================
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Use saber-domain CLI for most operations (auto-configures everything)
# 3. Only AZUREAI_OPENAI_* variables are required for basic usage
# 4. See README.md for detailed configuration documentation
# =========================================================================
