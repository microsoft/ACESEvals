# =========================================================================
# SABER Environment Configuration Template
# =========================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.template .env
#
# Then edit .env with your credentials (never commit .env to git!)
# =========================================================================

# -------------------------------------------------------------------------
# Azure OpenAI Configuration (REQUIRED)
# -------------------------------------------------------------------------
# Get these values from your Azure OpenAI resource in the Azure portal

# Your Azure OpenAI API key
AZUREAI_OPENAI_API_KEY=

# Your Azure OpenAI endpoint URL (should end with .openai.azure.com)
AZUREAI_OPENAI_BASE_URL=

# API version (use 2024-12-01-preview or later for latest features)
AZUREAI_OPENAI_API_VERSION=2024-12-01-preview

# -------------------------------------------------------------------------
# Optional: Alternative LLM Providers
# -------------------------------------------------------------------------
# Uncomment and configure if using OpenAI directly or other providers

# OpenAI (non-Azure)
# OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# -------------------------------------------------------------------------
# Domain Configuration (Auto-configured by saber-domain CLI)
# -------------------------------------------------------------------------
# These are typically auto-generated by the CLI and don't need manual editing
# Uncomment only if you need to override CLI behavior

# DOMAIN=excytin
# DOMAINS_ROOT=/path/to/oss_saber/domains
# SERVER_IMAGE=saber/excytin/server:latest
# CLIENT_IMAGE=saber/excytin/client:latest
# SANDBOX_IMAGE=saber/excytin/sandbox:latest

# -------------------------------------------------------------------------
# Server Configuration (Optional)
# -------------------------------------------------------------------------
# Uncomment to override default values

# REST_PORT=8000
# MCP_PORT=8001
# LOG_LEVEL=INFO

# -------------------------------------------------------------------------
# Docker Configuration (Optional)
# -------------------------------------------------------------------------
# Uncomment if you need custom Docker settings

# DOCKER_HOST=unix:///var/run/docker.sock
# COMPOSE_PROJECT_NAME=saber
# COMPOSE_PROFILES=server,client

# -------------------------------------------------------------------------
# Development Settings (Optional)
# -------------------------------------------------------------------------
# Uncomment for development/debugging

# DEBUG=false
# SABER_DEV_MODE=false

# =========================================================================
# Important Notes:
# =========================================================================
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Use saber-domain CLI for most operations (auto-configures everything)
# 3. Only AZUREAI_OPENAI_* variables are required for basic usage
# 4. See README.md for detailed configuration documentation
# =========================================================================
