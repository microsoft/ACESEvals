# Custom MySQL image for excytin domain - Incident 322
# Uses volume mounts for SQL/CSV data (now that server runs on host, not in Docker)

FROM mysql:8.0.36

# Copy health check script
COPY server/docker/db/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

# Use the same default configuration as base image
EXPOSE 3306
