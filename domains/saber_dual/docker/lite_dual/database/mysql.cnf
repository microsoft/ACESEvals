[mysqld]
# Enable general query log for blue team analysis
general_log = 1
general_log_file = /var/log/saber/query.log

# Enable slow query log for performance analysis
slow_query_log = 1
slow_query_log_file = /var/log/saber/slow.log
long_query_time = 2

# Enable error logging
log_error = /var/log/saber/error.log

# Enable binary logging for replication monitoring
log_bin = /var/log/saber/mysql-bin
server_id = 1

# Security settings
bind_address = 0.0.0.0