tasks:
- task_id: linux_001
  title: Write a detection rule to identify when APT or apt-get packa...
  description: Create a comprehensive detection rule based on the specified threat pattern
  inherit_shared: true
  execution_config:
    timeout: 1800
  initial_context:
    detection_objective: Write a detection rule to identify when APT or apt-get package managers spawn shell interpreters
      (sh, dash) as child processes, monitoring for Pre-Invoke or Post-Invoke patterns in the parent command line that indicate
      configuration hook abuse for arbitrary command execution
    question: Develop both Sigma rule and KQL query with actual query results demonstrating detection effectiveness
    platform: Linux
    mitre_techniques: &id001
    - T1059
    - T1546
    data_sources: &id002
    - DeviceProcessEvents
    - DeviceFileEvents
  submission_evaluation_config:
    strategy: trajectory_analysis
    criteria:
      detection_objective: Write a detection rule to identify when APT or apt-get package managers spawn shell interpreters
        (sh, dash) as child processes, monitoring for Pre-Invoke or Post-Invoke patterns in the parent command line that indicate
        configuration hook abuse for arbitrary command execution
      expected_techniques: *id001
      expected_data_sources: *id002
      regex_patterns: &id003
        initiatingprocessfilename: ^(apt|apt-get|bash)$
        initiatingprocesscommandline: .*Pre-Invoke.*
        filename: ^(sh|dash)$
        processcommandline: .*f8e2a4c6-7d9b-4f3e-8a1c-5e7f9d2b4c8a-T1.*
    scoring:
      max_score: 10.0
  subtasks:
  - subtask_id: c0_cti_analysis
    title: 'C0: CTI Report Usage'
    description: Evidence of threat intelligence analysis in agent execution
    objective: Agent must demonstrate use of CTI reports and threat intelligence
    step_evaluation_config:
      strategy: cti_tool_llm
      criteria:
        model: openai/azure/gpt-5.1
        steps_per_message: 20
    scoring:
      max_score: 1.25
      weight: 1.0
  - subtask_id: c1_threat_context
    title: 'C1: Threat Context - MITRE Techniques'
    description: MITRE ATT&CK techniques mentioned in final submission
    objective: Agent must reference relevant MITRE techniques in their analysis
    step_evaluation_config:
      strategy: trajectory_jaccard
      criteria:
        expected_items: *id001
        regex_pattern: T\d{4}(?:\.\d{3})?
    scoring:
      max_score: 0.75
      weight: 1.0
  - subtask_id: c2_data_exploration
    title: 'C2: Data Exploration - Data Sources'
    description: Data sources referenced in final submission
    objective: Agent must explore and reference available data sources
    step_evaluation_config:
      strategy: tool_call_jaccard
      criteria:
        expected_tools:
        - get_table_schema
        - sample_table_data
        expected_items: *id002
        param_name: table
    scoring:
      max_score: 1.0
      weight: 1.0
  - subtask_id: c3_query_execution
    title: 'C3: Query Execution - Multiple KQL Attempts'
    description: Agent executed KQL queries multiple times (iterative development)
    objective: Agent must test and execute KQL queries at least 2 times
    step_evaluation_config:
      strategy: tool_call_count
      criteria:
        tool_name: execute_kql_query
        min_executions: 2
    scoring:
      max_score: 0.5
      weight: 1.0
  - subtask_id: c4_detection_quality
    title: 'C4: Detection Quality - F1 + Sigma'
    description: Combined F1-based KQL validation and Sigma rule quality
    objective: Agent must produce high-quality detection rules with accurate KQL queries
    step_evaluation_config:
      strategy: f1_sigma_scoring
      criteria:
        detection_objective: Write a detection rule to identify when APT or apt-get package managers spawn shell interpreters
          (sh, dash) as child processes, monitoring for Pre-Invoke or Post-Invoke patterns in the parent command line that
          indicate configuration hook abuse for arbitrary command execution
        expected_techniques: *id001
        expected_data_sources: *id002
        regex_patterns: *id003
    scoring:
      max_score: 6.5
      weight: 1.0
