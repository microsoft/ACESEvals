# SABER Sandbox for CTI Realm domain
# Extends base SABER sandbox with Kusto client and CTI analysis tools
#
# NOTE: Referenced by eval.yaml as docker/Dockerfile.sandbox
FROM saber/sandbox:latest

# Switch to root to install domain-specific packages
USER root

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Azure CLI  (for Kusto / Azure Data Explorer queries)
# ---------------------------------------------------------------------------
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# ---------------------------------------------------------------------------
# CTI-specific Python packages
#   (requests already in base image)
# ---------------------------------------------------------------------------
RUN uv pip install --system --no-cache \
    azure-kusto-data \
    azure-kusto-ingest \
    azure-identity \
    pysigma \
    httpx \
    pyyaml \
    jsonschema \
    pandas \
    stix2

# ---------------------------------------------------------------------------
# Data directories (populated at build time or via volume mount)
#   Data must be downloaded before building this image. See README.md.
#   When data is available, uncomment the COPY lines below:
# ---------------------------------------------------------------------------
# COPY data/cti_reports/ /opt/cti_realm/data/cti_reports/
# COPY docker/kusto_init/ /opt/cti_realm/data/kusto_init/
# COPY data/sigma_rules.json /opt/cti_realm/data/sigma_rules.json
RUN mkdir -p /opt/cti_realm/data/cti_reports /opt/cti_realm/data/kusto_init /opt/cti_realm/tools

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV PYTHONPATH=/workspace:/opt/cti_realm:/opt/cti_realm/tools

# Domain-specific labels
LABEL saber.domain="cti_realm"
LABEL saber.component="sandbox"
LABEL saber.scenario="threat-intelligence"
