# SABER Server for CTI Realm domain
# Extends the generic SABER server base

FROM saber/server:latest

# Domain-specific labels
LABEL saber.domain="cti_realm"
LABEL saber.component="server"
LABEL saber.scenario="threat-intelligence"

# Copy domain-specific configuration
COPY server/config/ /app/config/

# Copy domain-specific data directory (contains CTI reports and artifacts)
COPY server/data/ /app/data/

# Set domain-specific environment variables
ENV SABER_DOMAIN=cti_realm

# Set domain-specific command
CMD ["python", "-m", "saber.server", "--start", "--domain", "cti_realm"]
